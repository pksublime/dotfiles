#################################
# patricks_macbook-specific ZSH configuration
#################################

alias tailscale=/Applications/Tailscale.app/Contents/MacOS/Tailscale

# Extend plugins beyond GENERAL_PLUGINS
plugins=("${GENERAL_PLUGINS[@]}" notify brew macos)

# Homebrew completions (must be before compinit in base)
FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"

# 1Password CLI plugins
source ~/.config/op/plugins.sh

# Buildkite API token.
# NOTE: do NOT resolve this at shell startup -- `op item get` blocks every new
# terminal on a 1Password auth prompt. Resolve on demand instead:
#   bk_token_load        # populates + exports BUILDKITE_API_TOKEN for this shell
#   op run -- <cmd>      # or scope it to a single command
bk_token_load() {
    [[ -n "$BUILDKITE_API_TOKEN" ]] && return 0
    BUILDKITE_API_TOKEN=$(op item get "Buildkite Claude weekly summary" \
        --fields credential --reveal) || {
        print -u2 "bk_token_load: could not read token from 1Password"
        return 1
    }
    export BUILDKITE_API_TOKEN
}

# Toolchain PATHs
export PATH="/usr/local/opt/ruby@3.0/bin:/usr/local/lib/ruby/gems/3.0.0/bin:$PATH"
export PATH="/usr/local/opt/llvm@16/bin:$PATH"
export PATH="/usr/local/sbin:$PATH"
export PATH="/usr/local/opt/grep/libexec/gnubin:$PATH"
export PATH="/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/MacOs/bin/:$PATH"
export PATH="/Applications/STMicroelectronics/ST_OpenOCD/bin:$PATH"
export PATH="/usr/local/opt/avr-gcc@10/bin:$PATH"
export PATH="/Applications/ArmGNUToolchain/13.3.Rel1/arm-none-eabi/bin:$PATH"

# STM32 environment
export STM32_PRG_PATH=/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/MacOs/bin
export STM32CubeMX_PATH=/Applications/STMicroelectronics/STM32CubeMX.app/Contents/Resources

# LM Studio
export PATH="$PATH:/Users/patricklittle/.lmstudio/bin"
